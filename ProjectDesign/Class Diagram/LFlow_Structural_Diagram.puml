@startuml LFlow_Structural_Diagram
skinparam classAttributeIconSize 0
skinparam monochrome false
skinparam shadowing true
skinparam roundcorner 8
skinparam class {
  BackgroundColor White
  ArrowColor #2563EB
  BorderColor #3B82F6
}

enum LeadStatus <<Enumeration>> {
  PENDING
  CONTACTED
  INTERESTED
  FOLLOW_UP_REQUIRED
  NO_ANSWER
  WON
  LOST
}

class User {
  + id: String
  + name: String
  + role: String
  + email: String
  + avatar: String
  + isSetter(): Boolean
  + isCloser(): Boolean
}

class HistoryEntry {
  + id: String
  + timestamp: String
  + userId: String
  + userName: String
  + userRole: String
  + fromStatus: String
  + toStatus: String
  + note: String
  + actionType: String
  + toJSON(): Object
}

class Lead {
  + id: String
  + customerName: String
  + phoneNumber: String
  + email: String
  + serviceInterest: String
  + appointmentDate: String
  + appointmentTime: String
  + setterId: String
  + closerId: String
  + status: LeadStatus
  + notes: List<String>
  + history: List<HistoryEntry>
  + createdAt: String
  + updatedAt: String
  + addNote(note: String, user: User): void
  + updateStatus(newStatus: LeadStatus, note: String, user: User): void
  + toJSON(): Object
}

interface ILeadRepository <<Interface>> {
  + save(lead: Lead): void
  + update(lead: Lead): void
  + getAll(): List<Lead>
  + getById(id: String): Lead
  + getByCloserId(closerId: String): List<Lead>
  + getBySetterId(setterId: String): List<Lead>
  + clearAll(): void
  + saveAll(leads: List<Lead>): void
}

class LocalStorageLeadRepository {
  - storageKey: String
  - _mapToDomain(rawJson: Object): Lead
  - _readRaw(): List<Object>
  - _writeRaw(items: List<Object>): void
  + save(lead: Lead): void
  + update(lead: Lead): void
  + getAll(): List<Lead>
  + getById(id: String): Lead
  + getByCloserId(closerId: String): List<Lead>
  + getBySetterId(setterId: String): List<Lead>
  + clearAll(): void
  + saveAll(leads: List<Lead>): void
}

class EventEmitter <<Observer>> {
  - events: Map<String, Set<Function>>
  + on(event: String, listener: Function): Function
  + off(event: String, listener: Function): void
  + emit(event: String, data: Any): void
  + clear(): void
}

class UserService {
  - demoUsers: List<User>
  - activeUser: User
  - eventEmitter: EventEmitter
  + getAllUsers(): List<User>
  + getClosers(): List<User>
  + getSetters(): List<User>
  + getUserById(id: String): User
  + getActiveUser(): User
  + setActiveUser(userId: String): User
}

class LeadService {
  - repository: ILeadRepository
  - userService: UserService
  - eventEmitter: EventEmitter
  + createAppointment(data: Object, setter: User): Lead
  + updateLeadOutcome(leadId: String, newStatus: LeadStatus, note: String, closer: User): Lead
  + getLeadsForCloser(closerId: String): List<Lead>
  + getLeadsBySetter(setterId: String): List<Lead>
  + getLeadById(id: String): Lead
  + getAllLeads(): List<Lead>
  + getStatistics(user: User): Object
  + validateAppointmentData(data: Object): Object
  + initSeedDataIfEmpty(seedItems: List<Object>): void
  + resetToSeedData(seedItems: List<Object>): void
}

class AppController {
  - leadService: LeadService
  - userService: UserService
  - dashboardController: DashboardController
  - modalController: ModalController
  - eventEmitter: EventEmitter
  + init(): void
  + renderUserSwitcherOptions(): void
  + renderHeaderUserInfo(): void
}

class DashboardController {
  - leadService: LeadService
  - userService: UserService
  - eventEmitter: EventEmitter
  - searchTerm: String
  - statusFilter: String
  + render(): void
  + renderRoleBanner(): void
  + renderStats(): void
  + renderTable(): void
  + resetFilters(): void
  + getFilteredLeads(): List<Lead>
}

class ModalController {
  - leadService: LeadService
  - userService: UserService
  - eventEmitter: EventEmitter
  + openCreateModal(): void
  + closeCreateModal(): void
  + openLeadDetails(leadId: String): void
  + closeDetailsModal(): void
  + refreshCurrentDetails(): void
  + populateCloserOptions(): void
}

' Relationships & Realizations
ILeadRepository <|.. LocalStorageLeadRepository : <<Realizes>>
LeadService "1" --> "1" ILeadRepository : <<Dependency Inversion>>
LeadService "1" --> "1" UserService : <<Uses>>
LeadService "1" --> "1" EventEmitter : <<Publishes Events>>
LeadService "1" ..> "0..*" Lead : <<Creates & Returns>>
LocalStorageLeadRepository "1" ..> "0..*" Lead : <<Instantiates / Persists>>

UserService "1" --> "0..*" User : <<Manages>>
Lead "1" *-- "0..*" HistoryEntry : <<Maintains Audit Trail>>
Lead "0..*" -right-> "1" LeadStatus : <<Has>>
Lead "0..*" --> "1" User : setter
Lead "0..*" --> "1" User : closer

AppController "1" --> "1" LeadService : <<Controls>>
AppController "1" --> "1" UserService : <<Controls>>
AppController "1" --> "1" DashboardController : <<Coordinates>>
AppController "1" --> "1" ModalController : <<Coordinates>>
DashboardController "1" --> "1" LeadService : <<Reads & Filters>>
DashboardController "1" --> "1" UserService : <<Uses>>
DashboardController "1" --> "1" EventEmitter : <<Subscribes>>
ModalController "1" --> "1" LeadService : <<Mutates & Updates>>
ModalController "1" --> "1" UserService : <<Uses>>

@enduml
