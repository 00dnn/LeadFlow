@startuml LFlow_Sequence_Diagram
autonumber
skinparam monochrome false
skinparam shadowing true
skinparam roundcorner 8
skinparam BoxPadding 10
skinparam ParticipantPadding 10

skinparam sequence {
  ArrowColor #2563EB
  ActorBorderColor #2563EB
  LifeLineBorderColor #3B82F6
  LifeLineBackgroundColor #EFF6FF
  ParticipantBorderColor #3B82F6
  ParticipantBackgroundColor White
  ParticipantFontStyle bold
}

actor "Appointment Setter\n(Sarah Jenkins)" as Setter #EFF6FF
actor "Assigned Closer\n(Alex Rivera)" as Closer #FEF3C7

box "Presentation Layer (MVC View & Controllers)" #F8FAFC
  participant "Web UI\n(index.html)" as UI
  participant "ModalController" as ModalCtrl
  participant "DashboardController" as DashCtrl
end box

box "Business Logic & Service Layer" #F0FDF4
  participant "LeadService" as Service
  participant "UserService" as UserSvc
  participant "EventEmitter\n(Observer Bus)" as EventBus
end box

box "Domain / Model Layer" #FAF5FF
  participant "Lead\n(Domain Entity)" as LeadEntity
  participant "HistoryEntry\n(Audit Record)" as HistoryRecord
end box

box "Data Persistence Layer" #FFFBEB
  participant "LocalStorageLeadRepository\n(ILeadRepository)" as Repo
  database "Browser\nlocalStorage" as LocalStorage
end box

== 1. Appointment Setter Schedules & Assigns Lead ==

Setter -> UI : Enters appointment details (Customer, Phone, Date, Closer, Notes)\nClicks "Create Appointment"
activate UI

UI -> ModalCtrl : _handleCreateSubmit(event)
activate ModalCtrl

ModalCtrl -> UserSvc : getActiveUser()
activate UserSvc
UserSvc --> ModalCtrl : setterUser (role: "setter")
deactivate UserSvc

ModalCtrl -> Service : createAppointment(payload, setterUser)
activate Service

Service -> Service : validateAppointmentData(payload)
note right of Service : Validates name (>= 2 chars), phone (>= 7 digits),\nrequired closer assignment, and valid date/time

create HistoryRecord
Service -> HistoryRecord : new HistoryEntry(setterUser, actionType="created", toStatus=PENDING)
activate HistoryRecord
HistoryRecord --> Service : creationHistory
deactivate HistoryRecord

create LeadEntity
Service -> LeadEntity : new Lead(id="LF-xxxxxx", status=PENDING, history=[creationHistory])
activate LeadEntity
LeadEntity --> Service : newLead
deactivate LeadEntity

Service -> Repo : save(newLead)
activate Repo
Repo -> LocalStorage : setItem("leadflow_leads", serializedLeads)
activate LocalStorage
LocalStorage --> Repo : success
deactivate LocalStorage
Repo --> Service : void
deactivate Repo

Service -> EventBus : emit("lead:created", newLead)
activate EventBus

EventBus -> DashCtrl : on("lead:created")
activate DashCtrl
DashCtrl -> DashCtrl : renderStats() & renderTable()
DashCtrl -> UI : Increments "Total Submitted" KPI & appends lead row to table
DashCtrl --> EventBus : done
deactivate DashCtrl
EventBus --> Service : done
deactivate EventBus

Service --> ModalCtrl : newLead
deactivate Service

ModalCtrl --> UI : closeCreateModal() & Toast.success("Appointment scheduled")
deactivate ModalCtrl

UI --> Setter : Displays success feedback & updated dashboard
deactivate UI

== 2. Assigned Closer Conducts Consultation & Records Outcome ==

Closer -> UI : Switches account to Alex Rivera;\nClicks "View Details" on assigned lead
activate UI
UI -> ModalCtrl : openLeadDetails(leadId)
activate ModalCtrl
ModalCtrl -> Service : getLeadById(leadId)
activate Service
Service -> Repo : getById(leadId)
activate Repo
Repo --> Service : lead
deactivate Repo
Service --> ModalCtrl : lead
deactivate Service
ModalCtrl --> UI : Renders Customer Meta, Audit Timeline, and Closer Update Form
deactivate ModalCtrl
UI --> Closer : Shows editable Outcome Form (status options & notes textarea)
deactivate UI

Closer -> UI : Selects newStatus="WON", inputs outcome notes,\nClicks "Save Status Update"
activate UI
UI -> ModalCtrl : _handleCloserUpdateSubmit(event, leadId)
activate ModalCtrl

ModalCtrl -> UserSvc : getActiveUser()
activate UserSvc
UserSvc --> ModalCtrl : closerUser (role: "closer")
deactivate UserSvc

ModalCtrl -> Service : updateLeadOutcome(leadId, newStatus="WON", note, closerUser)
activate Service

Service -> Service : verifyPermissions(lead, closerUser)
note right of Service : Asserts closerUser.role === 'closer'\nand lead.closerId === closerUser.id

Service -> LeadEntity : updateStatus("WON", note, closerUser)
activate LeadEntity

create HistoryRecord
LeadEntity -> HistoryRecord : new HistoryEntry(closerUser, fromStatus=PENDING, toStatus=WON, note)
activate HistoryRecord
HistoryRecord --> LeadEntity : updateHistory
deactivate HistoryRecord

LeadEntity -> LeadEntity : Appends immutable HistoryEntry to history list;\nUpdates status to WON and sets updatedAt timestamp
LeadEntity --> Service : void
deactivate LeadEntity

Service -> Repo : update(lead)
activate Repo
Repo -> LocalStorage : setItem("leadflow_leads", serializedLeads)
activate LocalStorage
LocalStorage --> Repo : success
deactivate LocalStorage
Repo --> Service : void
deactivate Repo

Service -> EventBus : emit("lead:updated", lead)
activate EventBus

EventBus -> DashCtrl : on("lead:updated")
activate DashCtrl
DashCtrl -> DashCtrl : renderStats() & renderTable()
DashCtrl -> UI : Increments "Deals Won" KPI & updates table row badge
DashCtrl --> EventBus : done
deactivate DashCtrl
EventBus --> Service : done
deactivate EventBus

Service --> ModalCtrl : lead
deactivate Service

ModalCtrl -> ModalCtrl : refreshCurrentDetails()
ModalCtrl --> UI : Re-renders timeline with new audit entry & Toast.success()
deactivate ModalCtrl
UI --> Closer : Displays updated audit trail with "WON" status pill
deactivate UI

== 3. Closed Feedback Loop: Setter Inspects Immutable Audit History ==

Setter -> UI : Switches back to Sarah Jenkins;\nClicks "View Details" on lead
activate UI
UI -> ModalCtrl : openLeadDetails(leadId)
activate ModalCtrl
ModalCtrl -> Service : getLeadById(leadId)
activate Service
Service -> Repo : getById(leadId)
activate Repo
Repo -> LocalStorage : getItem("leadflow_leads")
activate LocalStorage
LocalStorage --> Repo : serializedLeads
deactivate LocalStorage

Repo -> LeadEntity : reconstitute with history list
activate LeadEntity
LeadEntity --> Repo : lead (with complete HistoryEntry list)
deactivate LeadEntity

Repo --> Service : lead
deactivate Repo
Service --> ModalCtrl : lead
deactivate Service
ModalCtrl --> UI : Renders Read-Only View with complete chronological audit history
deactivate ModalCtrl
UI --> Setter : Setter reviews timestamped outcome notes and transition (PENDING -> WON)
deactivate UI

@enduml
